# YShop API root, including the /api/ path.
YSHOP_API_URL=http://127.0.0.1:8008/api/
HTTP_TIMEOUT_SECONDS=10.0
# JSON array of allowed H5 origins; empty disables browser cross-origin access.
CORS_ORIGINS=[]
# Optional local smoke-test credential (CLI only; never kept in service Settings).
# Fill locally with a Bearer header. Do not commit or share this value.
YSHOP_AUTHORIZATION=
# Optional runtime-only local Java launcher settings. Fill locally; never share passwords.
YSHOP_DB_NAME=
YSHOP_DB_USER=
YSHOP_DB_PASSWORD=

# Optional OpenAI-compatible generation model. Empty values leave chat unconfigured.
# The API key is local-only; never commit or share it.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30.0
# Optional explicit HTTP loopback proxy used only by the generation model client.
# Example: http://127.0.0.1:7892. System/ambient proxies are never inherited.
LLM_PROXY_URL=

# Completed conversation snapshots. Dedicated file inside service data or .tmp.
SESSION_DB_PATH=data/day5-sessions.sqlite3

# Local CPU demonstration-policy RAG. Relative paths use the service root.
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_MODEL_CACHE_DIR=.cache/fastembed
RAG_CHROMA_DIR=data/chroma
RAG_KNOWLEDGE_DIR=knowledge/policies
# Chroma candidate threshold; sentence evidence is evaluated separately.
RAG_MIN_SCORE=0.53
RAG_EVIDENCE_MIN_SCORE=0.60
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
